<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(EcoHousingSmokeTest)' != 'true'">net8.0</TargetFramework>
    <TargetFrameworks Condition="'$(EcoHousingSmokeTest)' == 'true'">net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EcoHousingExporter</AssemblyName>
    <EcoReferencePath Condition="'$(EcoReferencePath)' == ''"></EcoReferencePath>
    <EcoReferencePattern Condition="'$(EcoReferencePattern)' == ''">Eco*.dll</EcoReferencePattern>
    <OutputType Condition="'$(EcoHousingSmokeTest)' == 'true'">Exe</OutputType>
    <StartupObject Condition="'$(EcoHousingSmokeTest)' == 'true'">EcoHousingExporter.ExporterSmokeTest</StartupObject>
  </PropertyGroup>

  <ItemGroup Condition="'$(EcoHousingSmokeTest)' != 'true'">
    <Compile Remove="ExporterSmokeTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="EcoMod\UserCode\**\*.cs" />
    <Compile Remove="dist\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(EcoReferencePath)' != ''">
    <EcoReferenceAssembly Include="$(EcoReferencePath)\$(EcoReferencePattern)" />
    <Reference Include="@(EcoReferenceAssembly)">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
